{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Etapa 1 — Aprendizado Simbólico: árvore de decisão\n",
    "\n",
    "**Pergunta prática:** dado o perfil e os sintomas de um paciente com dengue notificado, ele será hospitalizado?\n",
    "\n",
    "**Dados:** Sinan/Dengue 2026 (`DENGBR26.csv`), Portal de Dados Abertos do SUS.\n",
    "\n",
    "Rode as células em ordem (Ambiente de execução → Executar tudo)."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from collections import Counter\n",
    "from sklearn.model_selection import train_test_split, StratifiedKFold, cross_val_score\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "\n",
    "SEED = 42\n",
    "CAMINHO_CSV = \"/DENGBR26.csv\"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Funções (ID3 do zero)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def entropia(y):\n",
    "    y = list(y)\n",
    "    if len(y) == 0:\n",
    "        return 0.0\n",
    "    p = np.array(list(Counter(y).values())) / len(y)\n",
    "    return float(-np.sum(p * np.log2(p)))\n",
    "\n",
    "\n",
    "def ganho(df, attr, alvo=\"alvo\"):\n",
    "    h_pai = entropia(df[alvo])\n",
    "    h_filhos = sum(len(sub) / len(df) * entropia(sub[alvo])\n",
    "                   for _, sub in df.groupby(attr))\n",
    "    return h_pai - h_filhos\n",
    "\n",
    "\n",
    "def arvore(df, atributos, alvo=\"alvo\", max_prof=None, prof=0):\n",
    "    \"\"\"ID3 com entropia. max_prof=None -> sem poda.\"\"\"\n",
    "    maj = int(df[alvo].mode()[0])\n",
    "    if df[alvo].nunique() == 1:\n",
    "        return int(df[alvo].iloc[0])\n",
    "    if not atributos or (max_prof is not None and prof >= max_prof):\n",
    "        return maj\n",
    "    A = max(atributos, key=lambda a: ganho(df, a, alvo))\n",
    "    return {\n",
    "        \"atributo\": A,\n",
    "        \"maj\": maj,\n",
    "        \"filhos\": {v: arvore(sub, [a for a in atributos if a != A],\n",
    "                             alvo, max_prof, prof + 1)\n",
    "                   for v, sub in df.groupby(A)},\n",
    "    }\n",
    "\n",
    "\n",
    "def prever(no, linha):\n",
    "    while isinstance(no, dict):\n",
    "        v = linha[no[\"atributo\"]]\n",
    "        if v not in no[\"filhos\"]:      # valor nunca visto neste ramo\n",
    "            return no[\"maj\"]\n",
    "        no = no[\"filhos\"][v]\n",
    "    return no\n",
    "\n",
    "\n",
    "def acuracia(no, df, alvo=\"alvo\"):\n",
    "    linhas = df.to_dict(\"records\")\n",
    "    return sum(prever(no, l) == l[alvo] for l in linhas) / len(linhas)\n",
    "\n",
    "\n",
    "def faixa_etaria(x):\n",
    "    # NU_IDADE_N: 1o dígito = unidade (4 = anos), demais = valor. Ex.: 4048 = 48 anos\n",
    "    if pd.isna(x):\n",
    "        return \"ignorado\"\n",
    "    x = int(x)\n",
    "    unidade, valor = x // 1000, x % 1000\n",
    "    anos = valor if unidade == 4 else 0     # horas, dias e meses = menos de 1 ano\n",
    "    if anos < 12:\n",
    "        return \"crianca\"\n",
    "    elif anos < 60:\n",
    "        return \"adulto\"\n",
    "    return \"idoso\"\n",
    "\n",
    "\n",
    "def regiao(x):\n",
    "    # SG_UF_NOT: código IBGE do estado; o 1o dígito é a região\n",
    "    if pd.isna(x):\n",
    "        return \"ignorado\"\n",
    "    d = str(int(float(x)))[0]\n",
    "    return {\"1\": \"norte\", \"2\": \"nordeste\", \"3\": \"sudeste\",\n",
    "            \"4\": \"sul\", \"5\": \"centro-oeste\"}.get(d, \"ignorado\")\n",
    "\n",
    "\n",
    "def preparar(df, atributos, seed=SEED):\n",
    "    \"\"\"Atributos como texto (nulo -> 'ignorado') + undersampling 50/50.\"\"\"\n",
    "    d = df[atributos + [\"alvo\"]].copy()\n",
    "    for a in atributos:\n",
    "        d[a] = d[a].fillna(\"ignorado\").astype(str)\n",
    "    pos = d[d[\"alvo\"] == 1]\n",
    "    neg = d[d[\"alvo\"] == 0].sample(n=len(pos), random_state=seed)\n",
    "    return pd.concat([pos, neg]).sample(frac=1, random_state=seed).reset_index(drop=True)\n",
    "\n",
    "\n",
    "def dummies(tr, te, attrs):\n",
    "    \"\"\"scikit-learn precisa de números: atributos viram colunas 0/1.\"\"\"\n",
    "    X_tr = pd.get_dummies(tr[attrs])\n",
    "    X_te = pd.get_dummies(te[attrs]).reindex(columns=X_tr.columns, fill_value=0)\n",
    "    return X_tr, X_te\n",
    "\n",
    "\n",
    "def cv_id3(dados, atributos, max_prof=None, k=5):\n",
    "    skf = StratifiedKFold(n_splits=k, shuffle=True, random_state=SEED)\n",
    "    dados = dados.reset_index(drop=True)\n",
    "    accs = []\n",
    "    for tr, va in skf.split(dados, dados[\"alvo\"]):\n",
    "        m = arvore(dados.iloc[tr], atributos, max_prof=max_prof)\n",
    "        accs.append(acuracia(m, dados.iloc[va]))\n",
    "    return accs\n",
    "\n",
    "\n",
    "def relatorio_niveis(df, atributos, niveis=3, rotulo=\"raiz\", nivel=1):\n",
    "    \"\"\"Imprime n, entropia e ganhos de cada nó até o nível indicado.\"\"\"\n",
    "    n = len(df)\n",
    "    c0, c1 = int((df[\"alvo\"] == 0).sum()), int((df[\"alvo\"] == 1).sum())\n",
    "    H = entropia(df[\"alvo\"])\n",
    "    ind = \"    \" * (nivel - 1)\n",
    "    print(f\"{ind}[nivel {nivel}] {rotulo} | n={n} (nao={c0}, sim={c1}) | H={H:.4f}\")\n",
    "    if H == 0 or not atributos:\n",
    "        print(f\"{ind}   (folha)\")\n",
    "        return\n",
    "    gs = sorted(((a, ganho(df, a)) for a in atributos), key=lambda t: -t[1])\n",
    "    print(f\"{ind}   ganhos: \" + \" | \".join(f\"{a}={g:.5f}\" for a, g in gs))\n",
    "    melhor = gs[0][0]\n",
    "    print(f\"{ind}   -> divide por: {melhor}\")\n",
    "    if nivel < niveis:\n",
    "        resto = [a for a in atributos if a != melhor]\n",
    "        for v, sub in df.groupby(melhor):\n",
    "            relatorio_niveis(sub, resto, niveis, f\"{melhor}={v}\", nivel + 1)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Carga dos dados"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "COLUNAS = [\"HOSPITALIZ\", \"NU_IDADE_N\", \"SG_UF_NOT\", \"CS_SEXO\", \"VOMITO\",\n",
    "           \"PETEQUIA_N\", \"DIABETES\", \"HIPERTENSA\", \"CEFALEIA\", \"LEUCOPENIA\",\n",
    "           \"MIALGIA\", \"DOR_RETRO\", \"ARTRALGIA\", \"LACO\", \"EXANTEMA\",\n",
    "           \"NAUSEA\", \"DOR_COSTAS\"]\n",
    "\n",
    "df = pd.read_csv(CAMINHO_CSV, sep=\",\", encoding=\"latin-1\",\n",
    "                 usecols=COLUNAS, low_memory=False)\n",
    "print(df.shape)\n",
    "print(df[\"HOSPITALIZ\"].value_counts(dropna=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Preparação: alvo, atributos derivados, balanceamento e divisão treino/teste\n",
    "\n",
    "Alvo: `HOSPITALIZ` (1 = hospitalizou, 2 = não). Linhas sem desfecho conhecido (nulo, 9 ou 0) são descartadas.\n",
    "Como só ~8,5% são hospitalizações, usamos *undersampling* para ficar 50/50 (linha de base = 50%)."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "n_total = len(df)\n",
    "df = df[df[\"HOSPITALIZ\"].isin([1, 2])].copy()\n",
    "df[\"alvo\"] = (df[\"HOSPITALIZ\"] == 1).astype(int)\n",
    "df[\"faixa_etaria\"] = df[\"NU_IDADE_N\"].apply(faixa_etaria)\n",
    "df[\"regiao\"] = df[\"SG_UF_NOT\"].apply(regiao)\n",
    "\n",
    "print(f\"registros no arquivo: {n_total}\")\n",
    "print(f\"usados (HOSPITALIZ = 1 ou 2): {len(df)} | descartados: {n_total - len(df)}\")\n",
    "print(\"\\nproporção do alvo antes de balancear:\")\n",
    "print(df[\"alvo\"].value_counts(normalize=True).round(4))\n",
    "print(\"\\nregiões:\");       print(df[\"regiao\"].value_counts())\n",
    "print(\"\\nfaixas etárias:\"); print(df[\"faixa_etaria\"].value_counts())\n",
    "\n",
    "CANDIDATOS = [\"regiao\", \"SG_UF_NOT\", \"faixa_etaria\", \"CS_SEXO\", \"VOMITO\",\n",
    "              \"PETEQUIA_N\", \"DIABETES\", \"HIPERTENSA\", \"CEFALEIA\", \"LEUCOPENIA\",\n",
    "              \"MIALGIA\", \"DOR_RETRO\", \"ARTRALGIA\", \"LACO\", \"EXANTEMA\",\n",
    "              \"NAUSEA\", \"DOR_COSTAS\"]\n",
    "\n",
    "dados_full = preparar(df, CANDIDATOS)\n",
    "treino_full, teste_full = train_test_split(\n",
    "    dados_full, test_size=0.2, random_state=SEED, stratify=dados_full[\"alvo\"])\n",
    "treino_full = treino_full.reset_index(drop=True)\n",
    "teste_full = teste_full.reset_index(drop=True)\n",
    "\n",
    "print(\"\\nbalanceado:\", dados_full.shape, \"| proporção:\", dados_full[\"alvo\"].mean())\n",
    "print(\"treino:\", treino_full.shape, \"| teste:\", teste_full.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Seleção de atributos\n",
    "\n",
    "Ganho de informação de cada candidato, medido **só no treino**. Colunas excluídas por vazamento do alvo:\n",
    "`DT_INTERNA`, `CLASSI_FIN`, `CRITERIO`, `EVOLUCAO`, `ALRM_*`, `GRAV_*` e similares."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "ganhos_cand = pd.Series({c: ganho(treino_full, c) for c in CANDIDATOS}).sort_values(ascending=False)\n",
    "print(ganhos_cand.round(5).to_string())\n",
    "\n",
    "# escolha final (6 atributos interpretáveis)\n",
    "ATRIBUTOS = [\"regiao\", \"LEUCOPENIA\", \"faixa_etaria\", \"VOMITO\", \"CEFALEIA\", \"HIPERTENSA\"]\n",
    "\n",
    "treino = treino_full[ATRIBUTOS + [\"alvo\"]].copy()\n",
    "teste = teste_full[ATRIBUTOS + [\"alvo\"]].copy()\n",
    "print(\"\\nEntropia da raiz:\", entropia(treino[\"alvo\"]))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Evolução das versões de atributos (ID3 sem poda)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "VERSOES = {\n",
    "    \"v1 - atributos iniciais\": [\"faixa_etaria\", \"CS_SEXO\", \"VOMITO\", \"PETEQUIA_N\", \"DIABETES\", \"HIPERTENSA\"],\n",
    "    \"v2 - com estado (SG_UF_NOT)\": [\"SG_UF_NOT\", \"LEUCOPENIA\", \"faixa_etaria\", \"VOMITO\", \"CEFALEIA\", \"HIPERTENSA\"],\n",
    "    \"v3 - com regiao (FINAL)\": ATRIBUTOS,\n",
    "}\n",
    "\n",
    "res = []\n",
    "for nome, attrs in VERSOES.items():\n",
    "    tr, te = treino_full[attrs + [\"alvo\"]], teste_full[attrs + [\"alvo\"]]\n",
    "    m = arvore(tr, attrs)\n",
    "    res.append({\"versao\": nome, \"treino\": acuracia(m, tr), \"teste\": acuracia(m, te)})\n",
    "print(pd.DataFrame(res).round(4).to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Entropia e ganho — níveis 1 a 3 (versão final)\n",
    "\n",
    "**Nível 1 (raiz):** tabela completa para a conta à mão."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "raiz = max(ATRIBUTOS, key=lambda a: ganho(treino, a))\n",
    "print(\"atributo da raiz:\", raiz, \"\\n\")\n",
    "\n",
    "tab = pd.crosstab(treino[raiz], treino[\"alvo\"]).rename(columns={0: \"nao\", 1: \"sim\"})\n",
    "tab[\"total\"] = tab[\"nao\"] + tab[\"sim\"]\n",
    "tab[\"p_sim\"] = tab[\"sim\"] / tab[\"total\"]\n",
    "tab[\"entropia\"] = [entropia(treino.loc[treino[raiz] == v, \"alvo\"]) for v in tab.index]\n",
    "tab[\"peso\"] = tab[\"total\"] / len(treino)\n",
    "\n",
    "H_pai = entropia(treino[\"alvo\"])\n",
    "H_filhos = (tab[\"peso\"] * tab[\"entropia\"]).sum()\n",
    "\n",
    "print(tab.round(5).to_string())\n",
    "print(f\"\\nn (treino) = {len(treino)}\")\n",
    "print(f\"H(pai) = {H_pai:.5f}\")\n",
    "print(f\"H(filhos) = soma(peso x entropia) = {H_filhos:.5f}\")\n",
    "print(f\"Ganho({raiz}) = H(pai) - H(filhos) = {H_pai - H_filhos:.5f}\")\n",
    "print(f\"conferencia com ganho(): {ganho(treino, raiz):.5f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**Níveis 1 a 3:** ganhos de todos os atributos em cada nó e o atributo escolhido."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "relatorio_niveis(treino, ATRIBUTOS, niveis=3)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. ID3 do zero vs scikit-learn (sem poda)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "modelo_id3 = arvore(treino, ATRIBUTOS)\n",
    "X_tr, X_te = dummies(treino, teste, ATRIBUTOS)\n",
    "clf = DecisionTreeClassifier(criterion=\"entropy\", random_state=SEED).fit(X_tr, treino[\"alvo\"])\n",
    "\n",
    "print(f\"ID3 treino:      {acuracia(modelo_id3, treino):.4f}\")\n",
    "print(f\"ID3 teste:       {acuracia(modelo_id3, teste):.4f}\")\n",
    "print(f\"sklearn treino:  {clf.score(X_tr, treino['alvo']):.4f}\")\n",
    "print(f\"sklearn teste:   {clf.score(X_te, teste['alvo']):.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Profundidade ótima e validação cruzada 5-fold\n",
    "\n",
    "Curva do scikit-learn (`max_depth` conta divisões binárias sobre colunas 0/1, não é idêntica à profundidade do ID3)."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "for d in range(1, 9):\n",
    "    c = DecisionTreeClassifier(criterion=\"entropy\", max_depth=d, random_state=SEED).fit(X_tr, treino[\"alvo\"])\n",
    "    print(f\"sklearn profundidade {d}: treino={c.score(X_tr, treino['alvo']):.4f}  teste={c.score(X_te, teste['alvo']):.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Profundidade do **ID3**, escolhida por 5-fold **dentro do treino** (sem olhar o teste). A profundidade ótima é a menor cuja média está a até 0,002 da melhor."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "medias = {}\n",
    "for p in range(1, len(ATRIBUTOS) + 1):\n",
    "    medias[p] = np.mean(cv_id3(treino, ATRIBUTOS, max_prof=p))\n",
    "    print(f\"ID3 profundidade {p}: media 5-fold (no treino) = {medias[p]:.4f}\")\n",
    "\n",
    "melhor_media = max(medias.values())\n",
    "p_otima = min(p for p, m in medias.items() if m >= melhor_media - 0.002)\n",
    "print(\"\\nprofundidade otima (ID3):\", p_otima)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Resultados finais: ID3 e scikit-learn, sem poda e com a profundidade ótima. A validação 5-fold usa o conjunto balanceado inteiro (treino + teste)."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "modelo_full = arvore(treino, ATRIBUTOS)\n",
    "modelo_poda = arvore(treino, ATRIBUTOS, max_prof=p_otima)\n",
    "\n",
    "dados_cv = pd.concat([treino, teste]).reset_index(drop=True)\n",
    "cv_full = cv_id3(dados_cv, ATRIBUTOS)\n",
    "cv_poda = cv_id3(dados_cv, ATRIBUTOS, max_prof=p_otima)\n",
    "\n",
    "X_all = pd.get_dummies(dados_cv[ATRIBUTOS])\n",
    "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n",
    "clf_poda = DecisionTreeClassifier(criterion=\"entropy\", max_depth=p_otima, random_state=SEED).fit(X_tr, treino[\"alvo\"])\n",
    "cv_sk_full = cross_val_score(DecisionTreeClassifier(criterion=\"entropy\", random_state=SEED), X_all, dados_cv[\"alvo\"], cv=skf)\n",
    "cv_sk_poda = cross_val_score(DecisionTreeClassifier(criterion=\"entropy\", max_depth=p_otima, random_state=SEED), X_all, dados_cv[\"alvo\"], cv=skf)\n",
    "\n",
    "resumo = pd.DataFrame([\n",
    "    {\"modelo\": \"ID3 sem poda\", \"treino\": acuracia(modelo_full, treino), \"teste\": acuracia(modelo_full, teste), \"5-fold (media)\": np.mean(cv_full)},\n",
    "    {\"modelo\": f\"ID3 prof={p_otima}\", \"treino\": acuracia(modelo_poda, treino), \"teste\": acuracia(modelo_poda, teste), \"5-fold (media)\": np.mean(cv_poda)},\n",
    "    {\"modelo\": \"sklearn sem poda\", \"treino\": clf.score(X_tr, treino[\"alvo\"]), \"teste\": clf.score(X_te, teste[\"alvo\"]), \"5-fold (media)\": cv_sk_full.mean()},\n",
    "    {\"modelo\": f\"sklearn max_depth={p_otima}\", \"treino\": clf_poda.score(X_tr, treino[\"alvo\"]), \"teste\": clf_poda.score(X_te, teste[\"alvo\"]), \"5-fold (media)\": cv_sk_poda.mean()},\n",
    "])\n",
    "print(resumo.round(4).to_string(index=False))\n",
    "print(\"\\n5-fold ID3 sem poda:\", [round(a, 4) for a in cv_full])\n",
    "print(\"5-fold ID3 prof\", p_otima, \":\", [round(a, 4) for a in cv_poda])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Salvar os conjuntos (para reuso na Etapa 2 e no repositório)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "treino.to_csv(\"treino_etapa1.csv\", index=False)\n",
    "teste.to_csv(\"teste_etapa1.csv\", index=False)\n",
    "print(\"salvos: treino_etapa1.csv, teste_etapa1.csv\")"
   ]
  }
 ],
